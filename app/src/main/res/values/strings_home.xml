    <!-- Troubleshooting -->
    <string name="trouble_desktop_title">The desktop doesn\'t open</string>
    <string name="trouble_desktop_body">On Home, open Recovery and tap View desktop log to see why. Tap Stop everything, then Start desktop. If the log mentions missing host files, use Repair host files.</string>
    <string name="trouble_black_title">Black screen</string>
    <string name="trouble_black_body">XFCE draws a few seconds after the display opens. If it stays black, stop the desktop and start it again. Settings > X11 Display controls scaling and fullscreen.</string>
    <string name="trouble_sound_title">No sound</string>
    <string name="trouble_sound_body">Settings > Audio shows whether PulseAudio is running and can restart it. Ubuntu plays through PULSE_SERVER=tcp:127.0.0.1, so don\'t install a sound server inside Ubuntu.</string>
    <string name="trouble_links_title">~/storage folders are empty</string>
    <string name="trouble_links_body">The links point at your phone\'s folders. On Home, allow shared storage, then tap Create links. Existing files with the same names are never replaced.</string>
    <string name="trouble_phantom_title">Android 12+ closes Linux apps</string>
    <string name="trouble_phantom_body">Android\'s phantom process killer can stop the desktop or terminal. Settings > Process killer fix turns it off with root, Shizuku or adb.</string>
    <string name="trouble_reinstall_title">Reinstall without losing files</string>
    <string name="trouble_reinstall_body">Re-run Ubuntu setup reinstalls the desktop packages and keeps your files. Repair host files re-extracts FluxLinux\'s tools and keeps Ubuntu too. Only Uninstall in Ubuntu settings deletes Ubuntu.</string>
