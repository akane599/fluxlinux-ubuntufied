<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Install foreground-service notification (OnboardingInstallRunner). %1$s = distro name. -->
    <string name="install_notif_title">AkaTerminal — Installing</string>
    <string name="install_notif_terminal">%1$s terminal</string>
    <string name="install_notif_terminal_desktop">%1$s terminal and desktop</string>
    <string name="install_notif_desktop_addon">%1$s desktop</string>
    <!-- Title label of a run that finished with a warning; the text is the warning itself. -->
    <string name="install_notif_done_warning">Install complete, with a warning</string>

    <!-- InstallController: a desktop add-on never replaces a running install. -->
    <string name="install_blocked_running">Another install is running. Try again when it finishes.</string>

    <!-- Install finished, but customization failed or was partial (InstallController.State.warning).
         %1$s = distro name. Terminal-only run / run that installed the desktop. -->
    <string name="install_warning_shell_setup">%1$s is installed, but its shell setup didn\'t finish, so zsh, Oh My Zsh or its plugins may be missing. Re-run setup to try again.</string>
    <string name="install_warning_desktop_setup">%1$s and its desktop are installed, but the desktop theme or shell setup didn\'t finish, so themes, fonts, Oh My Zsh or plugins may be missing. Re-run setup to try again.</string>

    <!-- Desktop add-on refused: the rootfs is not installed. %1$s = distro name. -->
    <string name="install_addon_needs_rootfs">Install %1$s first: the desktop is added to an installed system.</string>
    <!-- Chroot desktop add-on refused: root didn't answer (denied, failed or timed out), so the
         root-only rootfs couldn't be checked. %1$s = distro name. -->
    <string name="install_addon_root_unverified">Root didn\'t answer, so AkaTerminal couldn\'t check that %1$s is installed. Grant superuser to AkaTerminal, then retry.</string>

    <!-- DesktopLauncher: Ubuntu without the optional XFCE desktop. -->
    <string name="desktop_install_first">Install the desktop first (Home → Desktop)</string>
    <!-- DesktopLauncher: the last desktop install failed or was cancelled before it finished. -->
    <string name="desktop_install_incomplete">The desktop install didn\'t finish. Retry it from Home → Desktop.</string>

    <!-- Install wizard (InstallConfigScreen, "Re-run Ubuntu setup"). -->
    <string name="install_cfg_cta_terminal">Set up terminal</string>
    <string name="install_cfg_cta_terminal_root">Set up terminal (Root)</string>
    <string name="install_cfg_cta_terminal_desktop">Set up terminal and desktop</string>
    <string name="install_cfg_cta_terminal_desktop_root">Set up terminal and desktop (Root)</string>
    <string name="install_cfg_heading_terminal">Terminal only</string>
    <string name="install_cfg_heading_terminal_desktop">Terminal and desktop</string>
    <!-- %1$s = distro name. -->
    <string name="install_cfg_body_terminal">Runs %1$s setup: base packages, your user, zsh and Oh My Zsh. An installed system and its files are kept. The XFCE desktop can be added later from the Ubuntu page.</string>
    <string name="install_cfg_body_terminal_desktop">Runs %1$s setup: base packages, your user, zsh and Oh My Zsh, the XFCE4 desktop and the Flux desktop theme. An installed system and its files are kept.</string>
    <string name="install_cfg_bullet_shell">zsh, Oh My Zsh and plugins</string>
    <string name="install_cfg_bullet_xfce">XFCE4 desktop</string>
    <string name="install_cfg_bullet_theme">Desktop theme, wallpapers and fonts</string>
    <string name="install_done_terminal">Terminal setup complete</string>
    <string name="install_done_terminal_desktop">Terminal and desktop setup complete</string>
    <!-- The same, for a run that finished with a warning (InstallController.State.warning). -->
    <string name="install_done_terminal_warning">Terminal setup finished with a warning</string>
    <string name="install_done_terminal_desktop_warning">Terminal and desktop setup finished with a warning</string>
    <!-- Under a finished run's warning; Continue leads to the Ubuntu page. -->
    <string name="install_cfg_warning_hint">To try again, tap Re-run Ubuntu setup under Recovery on the Ubuntu page.</string>
</resources>
