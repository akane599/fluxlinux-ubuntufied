<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The app is always dark (MainActivity pins ThemeMode.DARK): the window and the launch
         splash are pure black (#000000, TerminalBackground in ui/theme/Color.kt), so
         light-mode phones don't flash white. No values-night copy: both modes use this. -->
    <style name="Theme.FluxLinux" parent="android:Theme.Material.NoActionBar">
        <item name="android:colorBackground">#FF000000</item>
        <item name="android:windowBackground">#FF000000</item>
    </style>
</resources>
